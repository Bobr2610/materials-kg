# Materials KG Core public settings

MATERIALS_NEO4J_URI=bolt://127.0.0.1:7687
MATERIALS_NEO4J_USER=neo4j
MATERIALS_NEO4J_PASSWORD=change-me
MATERIALS_NEO4J_DATABASE=neo4j
MATERIALS_REQUIRE_GRAPH_DB=true
MATERIALS_API_HOST=0.0.0.0
MATERIALS_API_PORT=8090
MATERIALS_API_TITLE=Materials KG Core API
MATERIALS_API_ENSURE_SCHEMA=true
MATERIALS_ENABLE_DESTRUCTIVE_API=true

# LLM provider selection.
# Меняешь DEFAULT_LLM_PROVIDER и DEFAULT_MODEL — код подхватит сам.
# Ключ/URL берутся только из LLM_API_KEY/LLM_BASE_URL.
# Endpoints may include /v1; materials-kg normalizes it.

DEFAULT_LLM_PROVIDER=yandex
DEFAULT_MODEL=deepseek-v4-flash
DEFAULT_EMBEDDING_MODEL=text-search-doc/latest
LLM_TEMPERATURE=0.7
LLM_CONTEXT_WINDOW=128000
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
LLM_API_KEY=
LLM_BASE_URL=

# Hypothesis Factory orchestration. Production path is Deep Agents; deterministic
# mode is kept only for explicit baseline and regression-test runs.
MATERIALS_HYPOTHESIS_ENGINE=deepagents
MATERIALS_DEEPAGENTS_ENABLED=true
MATERIALS_DEEPAGENTS_MAX_TOOL_STEPS=40

# Vision-Language модель — анализ PDF, изображений, диаграмм, таблиц.
# Если MATERIALS_VISION_PROVIDER пуст — vision analysis disabled.
# Если MATERIALS_VISION_MODEL пуст — используется DEFAULT_MODEL.
# Ключ/URL берутся из LLM_API_KEY/LLM_BASE_URL или MATERIALS_VISION_API_KEY/MATERIALS_VISION_BASE_URL.
MATERIALS_VISION_PROVIDER=yandex
MATERIALS_VISION_MODEL=qwen3.6-35b-a3b
MATERIALS_VISION_API_KEY=
MATERIALS_VISION_BASE_URL=
MATERIALS_DOCUMENT_VISION_ENABLED=false
MATERIALS_DOCUMENT_OCR_ENABLED=true
MATERIALS_OCR_LANGUAGES=eng+rus
MATERIALS_OCR_TIMEOUT_SECONDS=30
MATERIALS_OCR_MIN_TEXT_CHARS=40
MATERIALS_OCR_MIN_CONFIDENCE=0.55
MATERIALS_PDF_RENDER_DPI=180
# MATERIALS_PDF_MAX_PAGES=           # null = all pages
MATERIALS_GROBID_URL=
MATERIALS_GROBID_TIMEOUT_SECONDS=45
MATERIALS_GROBID_MIN_TEXT_CHARS=80

# Extraction tuning — batch_chars = truncation = chunk_size, no double chunking.
MATERIALS_LLM_EXTRACTION_MAX_BATCHES_PER_DOCUMENT=0
MATERIALS_LLM_EXTRACTION_BATCH_CHARS=25000
MATERIALS_INGESTION_LLM_TIMEOUT_SECONDS=60
MATERIALS_INGESTION_LLM_MAX_RETRIES=3
LLM_EMBEDDING_TRUNCATION_CHARS=25000
MATERIALS_LLM_EXTRACTION_CHUNK_SIZE=25000
MATERIALS_LLM_EXTRACTION_CHUNK_OVERLAP=2000

# Optional observability and runtime settings

LOG_LEVEL=INFO
LOG_FORMAT=simple
LOG_JSON=false
LOG_FILE=logs/materials-kg.log
DEFAULT_TIMEZONE=UTC
NO_PROXY=localhost,127.0.0.1
