# Materials KG Core public settings

MATERIALS_NEO4J_URI=bolt://127.0.0.1:7687
MATERIALS_NEO4J_USER=neo4j
MATERIALS_NEO4J_PASSWORD=change-me
MATERIALS_NEO4J_DATABASE=neo4j
MATERIALS_REQUIRE_GRAPH_DB=true
MATERIALS_API_HOST=0.0.0.0
MATERIALS_API_PORT=8090
MATERIALS_API_TITLE=Materials KG Core API
MATERIALS_API_ENSURE_SCHEMA=true
MATERIALS_ENABLE_DESTRUCTIVE_API=true

# LLM provider selection. Pick one provider/model here; the API, extraction,
# embeddings, streaming answers, scripts, and Deep Agents reuse this choice
# through kg_engine.llm_core.
# Agent-style aliases AGENT_PROVIDER and AGENT_DEFAULT_MODEL are also supported.
# Provider selection is explicit: spare keys for other providers are ignored.
#
# Configure either:
#   LLM_API_KEY / LLM_BASE_URL
# or:
#   <PROVIDER>_API_KEY / <PROVIDER>_BASE_URL
# where DEFAULT_LLM_PROVIDER=my-provider maps to MY_PROVIDER_API_KEY and
# MY_PROVIDER_BASE_URL. Endpoints may include /v1; materials-kg normalizes it.

DEFAULT_LLM_PROVIDER=my-provider
DEFAULT_MODEL=my-chat-model
DEFAULT_EMBEDDING_MODEL=my-embedding-model
LLM_TEMPERATURE=0.7
LLM_CONTEXT_WINDOW=128000
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
LLM_API_KEY=
LLM_BASE_URL=https://provider.example/v1

# Hypothesis Factory orchestration. Production path is Deep Agents; deterministic
# mode is kept only for explicit baseline and regression-test runs.
MATERIALS_HYPOTHESIS_ENGINE=deepagents
MATERIALS_DEEPAGENTS_ENABLED=true
MATERIALS_DEEPAGENTS_MAX_TOOL_STEPS=40

# Vision-Language model for document/image analysis.
# Used to interpret scanned PDFs, images, diagrams, charts, and tables-as-images.
# Configure a VLM provider explicitly. If MATERIALS_VISION_API_KEY and
# MATERIALS_VISION_BASE_URL are empty, the main generic LLM credentials are used.
# If MATERIALS_VISION_PROVIDER is empty, vision analysis is disabled.
MATERIALS_VISION_PROVIDER=
MATERIALS_VISION_MODEL=
MATERIALS_VISION_API_KEY=
MATERIALS_VISION_BASE_URL=
MATERIALS_DOCUMENT_VISION_ENABLED=false
MATERIALS_PDF_RENDER_DPI=180
# MATERIALS_PDF_MAX_PAGES=           # null = all pages

# Optional observability and runtime settings

LOG_LEVEL=INFO
LOG_FORMAT=simple
LOG_JSON=false
LOG_FILE=logs/materials-kg.log
DEFAULT_TIMEZONE=UTC
NO_PROXY=localhost,127.0.0.1
