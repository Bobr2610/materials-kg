# Materials KG Core public settings

MATERIALS_NEO4J_URI=bolt://127.0.0.1:7687
MATERIALS_NEO4J_USER=neo4j
MATERIALS_NEO4J_PASSWORD=change-me
MATERIALS_NEO4J_DATABASE=neo4j
MATERIALS_REQUIRE_GRAPH_DB=true
MATERIALS_API_HOST=0.0.0.0
MATERIALS_API_PORT=8090
MATERIALS_API_TITLE=Materials KG Core API
MATERIALS_API_ENSURE_SCHEMA=true
MATERIALS_ENABLE_DESTRUCTIVE_API=true

# LLM provider selection. Pick one provider/model here; the API, extraction,
# embeddings, streaming answers, scripts, and Deep Agents reuse this choice
# through kg_engine.llm_core.
# Agent-style aliases AGENT_PROVIDER and AGENT_DEFAULT_MODEL are also supported.
# Provider selection is explicit: spare keys for other providers are ignored.
#
# BUILT-IN PROVIDER SHORTCUTS:
#   yandex     - Yandex Foundation Models / OpenAI-compatible endpoint
#   openrouter - OpenRouter cloud API with a broad model catalog
#   polza      - Polza.ai OpenAI-compatible gateway
#   vllm       - Local/self-hosted OpenAI-compatible vLLM server
#   openai     - True OpenAI API or another OPENAI_BASE_URL-compatible endpoint
#   groq       - Groq OpenAI-compatible endpoint
#   mistral    - Mistral OpenAI-compatible endpoint
# Any other OpenAI-compatible provider can be used with provider-specific vars:
#   DEFAULT_LLM_PROVIDER=my-provider
#   MY_PROVIDER_API_KEY=...
#   MY_PROVIDER_BASE_URL=https://provider.example/v1
#
# COMMON MODEL EXAMPLES:
#   Yandex:     deepseek-v4-flash, qwen3.6-35b-a3b
#   OpenRouter: qwen/qwen3.6-plus, x-ai/grok-4.20, xiaomi/mimo-v2-omni,
#               google/gemini-2.5-flash, anthropic/claude-sonnet-4.6,
#               openai/gpt-5-mini, z-ai/glm-5.1, minimax/minimax-m2.7
#   Polza:      qwen/qwen3.6-plus, z-ai/glm-5.1, minimax/minimax-m2.7,
#               x-ai/grok-4.20, xiaomi/mimo-v2-omni, google/gemini-2.5-flash
#   vLLM:       Qwen/Qwen3-30B-A3B-Instruct-2507, deepseek/deepseek-v3.1-terminus
#   OpenAI:     gpt-4o-mini, gpt-5-mini
#   Groq:       groq/compound, llama-3.3-70b-versatile
#   Mistral:    mistral-large-latest, mistral-small-latest, mistral-medium-latest

DEFAULT_LLM_PROVIDER=yandex
DEFAULT_MODEL=deepseek-v4-flash
DEFAULT_EMBEDDING_MODEL=text-search-doc/latest
LLM_TEMPERATURE=0.7
LLM_CONTEXT_WINDOW=128000
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0

# Hypothesis Factory orchestration. Production path is Deep Agents; deterministic
# mode is kept only for explicit baseline and regression-test runs.
MATERIALS_HYPOTHESIS_ENGINE=deepagents
MATERIALS_DEEPAGENTS_ENABLED=true
MATERIALS_DEEPAGENTS_MAX_TOOL_STEPS=12

# Vision-Language model for document/image analysis.
# Used to interpret scanned PDFs, images, diagrams, charts, and tables-as-images.
# Configure a VLM provider explicitly. If MATERIALS_VISION_API_KEY is empty,
# the matching provider-specific key is used, e.g. YANDEX_API_KEY for yandex.
# Other providers' spare keys are ignored.
# If MATERIALS_VISION_PROVIDER is empty, vision analysis is disabled.
# Recommended VL-capable models:
#   Yandex:     qwen3.6-35b-a3b
#   OpenRouter: qwen/qwen3-vl-8b-instruct, openai/gpt-4o-mini, google/gemini-2.5-flash-lite
#   OpenAI:     gpt-4o, gpt-4o-mini
#   Polza:      google/gemini-2.5-flash, qwen/qwen2.5-vl-72b-instruct
MATERIALS_VISION_PROVIDER=yandex
MATERIALS_VISION_MODEL=qwen3.6-35b-a3b
MATERIALS_VISION_API_KEY=
MATERIALS_VISION_BASE_URL=
MATERIALS_DOCUMENT_VISION_ENABLED=false
MATERIALS_PDF_RENDER_DPI=180
# MATERIALS_PDF_MAX_PAGES=           # null = all pages

# Provider credentials/endpoints. Fill only the selected provider.
# Endpoints may include /v1; materials-kg normalizes it.

YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_API_KEY=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Optional observability and runtime settings

LOG_LEVEL=INFO
LOG_FORMAT=simple
LOG_JSON=false
LOG_FILE=logs/materials-kg.log
DEFAULT_TIMEZONE=UTC
NO_PROXY=localhost,127.0.0.1
