# Materials KG Core public settings

MATERIALS_NEO4J_URI=bolt://127.0.0.1:7687
MATERIALS_NEO4J_USER=neo4j
MATERIALS_NEO4J_PASSWORD=change-me
MATERIALS_NEO4J_DATABASE=neo4j
MATERIALS_REQUIRE_GRAPH_DB=true
MATERIALS_API_HOST=0.0.0.0
MATERIALS_API_PORT=8090
MATERIALS_API_TITLE=Materials KG Core API
MATERIALS_API_ENSURE_SCHEMA=true
MATERIALS_ENABLE_DESTRUCTIVE_API=true

# LLM provider selection. Pick one provider/model here; the API, extraction,
# embeddings, streaming answers, and scripts reuse this choice everywhere.
# Agent-style aliases AGENT_PROVIDER and AGENT_DEFAULT_MODEL are also supported.
#
# PROVIDER OPTIONS:
#   openrouter - OpenRouter cloud API with a broad model catalog
#   polza      - Polza.ai OpenAI-compatible gateway
#   vllm       - Local/self-hosted OpenAI-compatible vLLM server
#   openai     - True OpenAI API or another OPENAI_BASE_URL-compatible endpoint
#   groq       - Groq OpenAI-compatible endpoint
#   mistral    - Mistral OpenAI-compatible endpoint
#
# COMMON MODEL EXAMPLES:
#   OpenRouter: qwen/qwen3.6-plus, x-ai/grok-4.20, xiaomi/mimo-v2-omni,
#               google/gemini-2.5-flash, anthropic/claude-sonnet-4.6,
#               openai/gpt-5-mini, z-ai/glm-5.1, minimax/minimax-m2.7
#   Polza:      qwen/qwen3.6-plus, z-ai/glm-5.1, minimax/minimax-m2.7,
#               x-ai/grok-4.20, xiaomi/mimo-v2-omni, google/gemini-2.5-flash
#   vLLM:       Qwen/Qwen3-30B-A3B-Instruct-2507, deepseek/deepseek-v3.1-terminus
#   OpenAI:     gpt-4o-mini, gpt-5-mini
#   Groq:       groq/compound, llama-3.3-70b-versatile
#   Mistral:    mistral-large-latest, mistral-small-latest, mistral-medium-latest

DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_MODEL=qwen/qwen3.6-plus
DEFAULT_EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_TEMPERATURE=0.7
LLM_CONTEXT_WINDOW=128000
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0

# Provider credentials/endpoints. Fill only the selected provider.
# Endpoints may include /v1; materials-kg normalizes it.

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_API_KEY=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Optional observability and runtime settings

LOG_LEVEL=INFO
LOG_FORMAT=simple
LOG_JSON=false
LOG_FILE=logs/materials-kg.log
DEFAULT_TIMEZONE=UTC
NO_PROXY=localhost,127.0.0.1
